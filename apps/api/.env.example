# Copie para .env e configure apenas o que for utilizar.
# Não inclua segredos no Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Somente em instalações locais/individuais. NUNCA habilite em hospedagem pública.
# Execute o FastAPI apenas em 127.0.0.1 e com --no-access-log.
ALINHA_DEPLOYMENT_MODE=community
ALINHA_LOCAL_AUTH_ENABLED=0

# Ollama é executado localmente e não utiliza chave.
OLLAMA_MODEL=qwen2.5:7b

FRONTEND_ORIGIN=http://localhost:3000
