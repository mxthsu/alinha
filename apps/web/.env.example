NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: login Google da pessoa usuária (não é conexão Gemini/OpenAI).
# Configure via Google Cloud Console: tipo de app "Web",
# redirecionamento autorizado http://localhost:3000/api/auth/callback/google
# O login Google é desativado até que todas as três variáveis estejam configuradas.
# Nunca inclua chaves reais neste arquivo versionado.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Gere um segredo aleatório com pelo menos 32 caracteres.
# Ex.: npx auth secret (ou openssl rand -base64 33).
AUTH_SECRET=
